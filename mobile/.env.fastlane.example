# Copy this file to .env.fastlane and fill in the credentials for the stores you manage.

APP_STORE_BUNDLE_ID="com.example.myapp"
APP_STORE_TEAM_ID="YOUR_DEVELOPER_TEAM_ID"
APP_STORE_CONNECT_ISSUER_ID="YOUR_ISSUER_ID"
APP_STORE_CONNECT_KEY_ID="YOUR_KEY_ID"
APP_STORE_CONNECT_KEY_CONTENT="BASE64_ENCODED_P8_CONTENT"
# Optional simple price tier if you use `bundle exec fastlane ios update_price`
APP_STORE_PRICE_TIER="0"

PLAY_STORE_PACKAGE_NAME="com.example.myapp"
# Set exactly one of the Play Store credentials values below.
# PLAY_STORE_JSON_KEY_PATH is relative to mobile/ unless you use an absolute path.
PLAY_STORE_JSON_KEY_PATH=".secrets/google-play-service-account.json"
# PLAY_STORE_JSON_KEY_DATA='{"type":"service_account",...}'
# Track used to resolve the existing release whose changelog is updated.
PLAY_STORE_TRACK="production"
# Optional override when the selected track contains more than one release.
# PLAY_STORE_VERSION_CODE="123"
