# SERVER ONLY. Copy to supabase/.env.dev or .env.stg (ignored).
# Leave blank until actual Meta access/endpoint/model is confirmed in T01.1.
META_API_KEY=
META_API_URL=
META_MODEL=

# Prepared policy only: future handlers must enforce this; no billing is installed.
BILLING_ENABLED=false

# Hosted Edge Functions already receive SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY from Supabase. Do not upload reserved SUPABASE_ names
# with secrets set. For local serving, use the local stack's injected credentials.
# Never copy service-role/secret keys, database passwords or this file into Flutter.
# RevenueCat is unconfigured; no webhook secret or paid product is needed now.
