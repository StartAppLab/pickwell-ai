# SERVER ONLY. Copy to supabase/.env.dev or .env.stg (ignored).
# Leave blank until actual Meta access/endpoint/model is confirmed in T01.1.
META_API_KEY=
META_API_URL=
META_MODEL=

# Prepared policy only: future handlers must enforce this; no billing is installed.
BILLING_ENABLED=false

# T01.1 isolated operator spike; disabled and not installed/deployed by default.
SPIKE_ENABLED=false
SPIKE_OPERATOR_TOKEN=
SPIKE_USER_ID=

# Hosted Edge Functions already receive SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY from Supabase. Do not upload reserved SUPABASE_ names
# with secrets set. For local serving, use the local stack's injected credentials.
# Never copy service-role/secret keys, database passwords or this file into Flutter.
# RevenueCat is unconfigured; no webhook secret or paid product is needed now.

# T02.3 server-only network HMAC key, generated with a cryptographic RNG (>=32 bytes).
# Required by the future lookup/analysis adapters; never ship to Flutter.
PICKWELL_NETWORK_HASH_SECRET=
# Leave unset until the deployment's ingress overwrite/append behavior is verified.
# Otherwise all requests share a conservative unknown-network bucket.
# Supported: x-forwarded-for, cf-connecting-ip, x-real-ip.
PICKWELL_TRUSTED_IP_HEADER=
# Number of trusted values counted from the RIGHT; configure only with trusted ingress.
PICKWELL_TRUSTED_PROXY_HOPS=
# Inference/spend controls are audited database configuration, not client flags.
# quota_controls.inference_enabled=false until model and worst-case bounds reviewed.
